# ULTRA-NEWS — Environment Variables
# Copy this to .env and fill in values.

# ============================================================================
# Backend (Django)
# ============================================================================

# REQUIRED when DEBUG=0. The app refuses to start without it rather than
# falling back to a default key committed to this repository.
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_API_KEY=change-me-to-a-secure-random-key

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/ultranews

# Connection reuse. Processes reaching Postgres =
#   gunicorn workers + (celery workers x concurrency) x 3 queues,
# which exhausts a default max_connections=100 before CPU does.
#
# Behind pgbouncer in TRANSACTION pooling mode, set both of these:
#   DB_CONN_MAX_AGE=0                    (let the pooler own reuse)
#   DB_DISABLE_SERVER_SIDE_CURSORS=1     (incompatible with transaction pooling)
DB_CONN_MAX_AGE=600
DB_DISABLE_SERVER_SIDE_CURSORS=0

# Cache backend: redis | locmem
# `locmem` removes the Redis dependency entirely, which is what makes the $0
# deployment path in DEPLOYMENT.md possible. Correct only on a SINGLE-process
# deployment — multiple workers would each keep a divergent cache.
CACHE_BACKEND=redis

# Redis (cache + Celery broker)
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — frontend URL(s), comma-separated
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Proxy trust
# ----------------------------------------------------------------------------
# Set to 1 ONLY when every request reaches the app through a reverse proxy that
# overwrites X-Forwarded-For. Left at 0, rate limiting keys off REMOTE_ADDR,
# which a client cannot forge. Turning this on without a proxy in front lets
# anyone bypass rate limits by sending their own header.
TRUST_PROXY_HEADERS=0
# Number of proxies in front of the app; the client IP is read this many hops
# from the right of X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# ----------------------------------------------------------------------------
# Admin endpoint auth
# ----------------------------------------------------------------------------
# REQUIRED for the OIDC-authenticated /admin/trigger-ingest endpoint. A valid
# GitHub Actions token only proves the request came from GitHub — not from YOUR
# workflow — so without this, any workflow in any repository would be trusted.
GITHUB_OIDC_REPOSITORY=your-org/your-repo

# ----------------------------------------------------------------------------
# Frontend cache invalidation
# ----------------------------------------------------------------------------
# Backend -> Next.js on-demand revalidation. Both sides must share the secret.
# Leave blank to disable revalidation entirely (it fails closed, not open).
NEXTJS_URL=http://frontend:3000

# Public origin used for absolute links in outbound RSS. Distinct from
# NEXTJS_URL, which is an internal service name unreachable from outside.
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-to-a-secure-random-key

# ----------------------------------------------------------------------------
# AI synthesis (optional)
# ----------------------------------------------------------------------------
# Ultra News runs FULLY WITHOUT an AI provider. With none configured, briefs and
# Ask answers are assembled from the retrieved sources directly. This is a
# supported first-class mode, not a degraded one — you can self-host the whole
# product with zero inference spend.
#
# Which provider answers. Presets supply the base URL, the model and the
# fallback chain, so a working config is TWO variables: provider + key.
#
#   groq        14,400 req/day free on llama-3.1-8b-instant, no card. Default.
#   cerebras    similar free allowance, same OpenAI-compatible shape.
#   openrouter  free `:free` model slugs, smaller daily allowance.
#   gemini      generous per-minute, small per-day. Fine for local work.
#   openai      paid.
#   ollama      local, needs LLM_BASE_URL + LLM_MODEL. No key.
#   none        keyless — answers and briefs are built from the retrieved
#               sources directly. A supported mode, not a broken one.
LLM_PROVIDER=groq

# Groq: console.groq.com/keys
LLM_API_KEY=

# Leave BLANK to accept the provider's preset. Setting these to a model that
# belongs to a different provider is the classic misconfiguration — every call
# 404s while the key looks fine.
LLM_MODEL=
LLM_FALLBACK_MODELS=

# Only for providers with no preset (Ollama, vLLM, LM Studio). Local servers
# usually need no API key, so URL and model are the required pair.
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
LLM_BASE_URL=

# Daily spend ceilings — circuit breakers, enforced atomically in Redis. These
# are GLOBAL, so on a public deployment one heavy user can exhaust the day for
# everyone. Size them to a budget you are willing to lose.
MAX_ASK_DAILY_REQUESTS=500
MAX_SYNTHESIS_DAILY_REQUESTS=200

# ----------------------------------------------------------------------------
# Ingest cadence & retention
# ----------------------------------------------------------------------------
# Conditional GET means an unchanged feed costs one 304 with no body, so polling
# more often is cheap. Deep-fetch work scales with NEW articles, not interval.
INGEST_INTERVAL_SECONDS=900
CLUSTER_INTERVAL_SECONDS=180

# Measured at ~9.2 KB/article and ~3.7 KB/raw document — about 3.3 GB/year at
# 1,000 articles a day. Set RETENTION_ENABLED=0 to keep a permanent archive.
RETENTION_ENABLED=1
RETENTION_RAW_DOCUMENT_DAYS=14
RETENTION_ARTICLE_PAYLOAD_DAYS=45
RETENTION_UNCORROBORATED_STORY_DAYS=90

# ============================================================================
# Frontend (Next.js)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must match the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me-to-a-secure-random-key

# Comma-separated image host allowlist for next/image. Defaults to the CDNs used
# by the sources in core/source_registry.py. Never set this to "**" — that turns
# the deployment into an open image proxy.
# IMAGE_HOST_ALLOWLIST=**.bbci.co.uk,**.guim.co.uk

# ============================================================================
# Observability
# ============================================================================
# Prometheus scrape endpoint at /metrics. It exposes internal state — clustering
# backlog, per-source failure counts, AI spend — so it is access-controlled by
# default. Leave both controls empty only when the port is already private.
METRICS_ENABLED=1
METRICS_ALLOWED_IPS=
METRICS_TOKEN=

# REQUIRED when serving under `gunicorn --workers N`. prometheus_client keeps
# counters in process memory, so without this a scrape returns whichever worker
# answered it — plausible-looking numbers that jump at random. Point it at a
# writable, EMPTY-ON-BOOT directory:
#   PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# Single-process servers (the compose default, uvicorn) can leave it unset.
PROMETHEUS_MULTIPROC_DIR=

# The metric worth alerting on first:
#   ultranews_articles_pending_clustering
# An article that is never clustered is invisible to every reader, while every
# request still returns 200. Nothing else surfaces that failure.
#
# Others worth a graph:
#   ultranews_ingest_outcomes_total{outcome="failure"}   feeds breaking
#   ultranews_llm_calls_total{outcome="fallback"}        primary model degrading
#   ultranews_answer_cache_total{result="hit"}           the main cost lever
#   ultranews_http_request_seconds                       latency by route

# Error tracking. Optional and OFF by default — this is open source, and nobody
# self-hosting should ship exceptions to a third party without choosing to.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
